# 行尾与二进制规范
* text=auto

# Windows 批处理必须 CRLF
*.bat text eol=crlf

# Windows 二进制
*.png binary
*.db binary
*.dat binary

# 源码统一 LF
*.py text eol=lf
*.ts text eol=lf
